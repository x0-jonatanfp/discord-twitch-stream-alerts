# Copy to .env and fill with your own credentials. Never commit .env.

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Twitch Developer application -> Client ID and Client Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Filled automatically by `pnpm auth:twitch`; do not share or commit.
TWITCH_USER_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_USER_TOKEN_EXPIRES_AT=
TWITCH_REDIRECT_URI=http://localhost:3000

# Presence format matches server-status. A Custom activity shows its free-form state;
# the URL field is only used by Streaming activities.
BOT_ACTIVITY_TYPE=Custom
BOT_ACTIVITY_NAME=x0void.com
BOT_ACTIVITY_STATE=🔗 x0void.com
BOT_ACTIVITY_URL=x0void.com

# Local per-server settings (copy config/guilds.example.json to config/guilds.json)
GUILD_CONFIG_PATH=config/guilds.json
LIVE_STATE_PATH=data/live-state.json

# Show stream viewer count in Discord alerts (opt-in; defaults to false)
SHOW_VIEWER_COUNT=false

# Reconcile REST state after websocket reconnects and missed events
TWITCH_RECONCILE_INTERVAL_SECONDS=60
LOG_LEVEL=info
